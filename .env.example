# Supabase Database Credentials (PostgreSQL with pgvector)
SUPABASE_DB_HOST=db.zmruzdoeslwpccppejjk.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_password_here

# Groq API Configuration (Recommended for Fast Multi-Agent CrewAI Reasoning)
# Get your API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Google Gemini API Configuration (Alternative for RAG Generation)
# Provide your Google Gemini API Key here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# Grounded Context Budget & Bounds Configuration
MAX_CONVERSATION_MESSAGES=20
MAX_CONTEXT_CHUNKS=10
MAX_CONTEXT_CHARACTERS=12000

# Crawler Configuration
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_REQUEST_DELAY=1.0
CRAWLER_MAX_RETRIES=3
CRAWLER_REQUEST_TIMEOUT=30.0
CRAWLER_MAX_DEPTH=10
CRAWLER_USER_AGENT=SAPUtilitiesRAGBot/1.0
