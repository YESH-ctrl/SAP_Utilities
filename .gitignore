# ==========================================
# Security & Secrets (Strictly Never Commit)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# ==========================================
# Testing & Coverage
# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ==========================================
# Node.js & Frontend Artifacts
# ==========================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Ephemeral Crawler & Scraper Storage
# ==========================================
storage/raw/*
!storage/raw/.gitkeep
storage/cleaned/*
!storage/cleaned/.gitkeep
storage/debug/*
!storage/debug/.gitkeep
scratch/
*.log

# ==========================================
# Operating System & IDE Artifacts
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp
*.temp
